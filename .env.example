# Copy this file to .env and change values as needed. Every setting is optional.

# Folder where ChromaDB stores its files (relative paths are relative to the repo root).
CHROMA_PERSIST_DIR=vectorstore
CHROMA_COLLECTION=documents

# Embedding provider. Only "hash" (offline MOCK, lexical, not semantic) exists for now.
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=256
